<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

			 x:Class="SchoolAssistancePlatform.UI.AuthView">

	<StackPanel HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Spacing="10">

		<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/school.png"
				Width="64" Height="64"
				Margin="10"/>
		
		<TextBox PlaceholderText="Логин" Text="{Binding Login}"
				 Width="300"/>
		
		<TextBox PlaceholderText="Пароль" PasswordChar="*" Text="{Binding Password}" />
		
		<Button Content="Войти" Command="{Binding LoginCommand}"
				Width="300"/>
	</StackPanel>

</UserControl>
