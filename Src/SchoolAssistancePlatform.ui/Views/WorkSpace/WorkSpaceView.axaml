<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

			 x:Class="SchoolAssistancePlatform.UI.WorkSpaceView">

	<Grid RowDefinitions="70, *">

		<Border BorderThickness="0 0 0 1"
				BorderBrush="{DynamicResource BorderBrushColor}">
			<Grid ColumnDefinitions="Auto, *, Auto" Margin="10">

				<StackPanel Orientation="Horizontal">
					<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/school.png"
						   Width="32" Height="32"
						   Margin="10"/>
					<TextBlock Text="МАОУ СОШ №17"
							   VerticalAlignment="Center"
							   FontSize="16"
							   FontWeight="Black"/>
				</StackPanel>

				<StackPanel Grid.Column="1"
							HorizontalAlignment="Center"
							Orientation="Horizontal">

					<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/globe.png"
						   Width="32" Height="32"
						   Margin="10"/>

					<TextBox Width="300"
							 BorderThickness="0"
							 PlaceholderText="Поиск"
							 VerticalContentAlignment="Center"
							 HorizontalAlignment="Center"/>                    
						
				</StackPanel>

				<Grid Grid.Column="2"
					  ColumnDefinitions="Auto, Auto, Auto">

					<Button Background="Transparent"
							Grid.Column="0"
                            Command="{Binding ChangeThemeCommand}">
						<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/dark-mode.png"
							Width="32" Height="32"
							Margin="10"/>
                    </Button>

					<ToggleButton x:Name="notification"
                                  Background="Transparent"
							      Grid.Column="1"
							      Margin="10 0">
						<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/notification.png"
							Width="32" Height="32"
							Margin="10"/>
					</ToggleButton>

					<Button Background="Transparent"
							Grid.Column="2">
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center">
							
							<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/user.png"
								Width="32" Height="32"
								Margin="10"/>

							<TextBlock Text="{Binding WorkSpaceOwnerName}"
									   VerticalAlignment="Center"
									   Margin="10"/>

						</StackPanel>
					</Button>

                    <Popup IsOpen="{Binding #notification.IsChecked}"
                           Width="300" Height="300"
                           PlacementTarget="{Binding #notification}"
                           Placement="Bottom">
                        <Border BorderThickness="1"
                                Margin="0 10"
                                Background="White"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                CornerRadius="10">

                            <TextBlock Text="Нет уведомлений"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            
                        </Border>
                        
                    </Popup>

				</Grid>
				
			</Grid>
		</Border>

		<Grid ColumnDefinitions="300, *"
			  Grid.Row="1">
			<ListBox ItemsSource="{Binding MenuItems}"
				 SelectedItem="{Binding SelectedMenuItem}"
				 DisplayMemberBinding="{Binding Page.Title}">
			</ListBox>

		<ContentControl
			Grid.Column="1"
			Content="{Binding SelectedMenuItem.Control}" />
		</Grid>

	</Grid>

</UserControl>
