<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchoolAssistancePlatform.UI.CurriculumPageView">
    <Grid RowDefinitions="Auto, *"
          Margin="20">

		<Grid ColumnDefinitions="*, Auto"
			  Margin="0 0 0 20">

			<Border BorderThickness="1"
					BorderBrush="#CCCCCC"
					Margin="0 0 20 0"
					CornerRadius="3">
                <Grid VerticalAlignment="Center"
                      ColumnDefinitions="*, Auto">                    
				    <StackPanel VerticalAlignment="Center"
				    			Orientation="Horizontal"
				    			Margin="20 0">
				    	<ComboBox PlaceholderText="Класс"
				    			  Width="180"
				    			  Margin="0 0 20 0"/>
				    	<ComboBox PlaceholderText="Учебный год"
				    			  Width="180"/>
				    </StackPanel>

                    
				    <ToggleButton x:Name="notification"
				    			  Background="Transparent"
                                  IsChecked="{Binding ApplyFilter}"
				    			  Grid.Column="1">
				    	<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/filter.png"
				    		Width="32" Height="32"
				    		Margin="10"/>
				    </ToggleButton>

                </Grid>
			</Border>

			<Button HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					Background="Transparent"
					BorderThickness="1"
					BorderBrush="#CCCCCC"
					Grid.Column="1"
					Command="{Binding EditCurriculumCommand}">
			
				<Grid ColumnDefinitions="Auto, *"
					  HorizontalAlignment="Stretch"
					  Margin="10 0">
			
					 <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/edit.png"
							Width="32" Height="32"
							HorizontalAlignment="Center"
							Margin="10"/>
			
					<TextBlock Text="Редактировать"
							   FontWeight="Bold"
							   Grid.Column="1"
							   VerticalAlignment="Center"/>
				</Grid>
			
			</Button>
		</Grid>

    <DockPanel Grid.Row="1">


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#BDC3C7"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="White"
                    BoxShadow="0 2 4 rgba(0,0,0,0.1)">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> 
                        <RowDefinition Height="*"/> 
                    </Grid.RowDefinitions>


                    <Border Grid.Row="0" 
                            Background="#34495E"
                            CornerRadius="8,8,0,0">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="500"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="📖 Предмет" 
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontSize="14"
                                       HorizontalAlignment="Left"/>
                            
                            <TextBlock Grid.Column="1"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontSize="14"
                                       HorizontalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="2"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontSize="14"
                                       HorizontalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="3" 
                                       Text="Норма ФГОС (мин-макс)" 
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <ListBox ItemsSource="{Binding StudyPlanItems}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#ECF0F1" 
                                            BorderThickness="0,0,0,1">
                                        
                                        <Button Command="{Binding $parent[ListBox].DataContext.SelectSubjectCommand}"
                                                CommandParameter="{Binding}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0">
                                            
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#F0F3F4"/>
                                                </Style>
                                            </Button.Styles>
                                            
                                            <Grid Margin="10 8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding Subject}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock">
                                                            <Setter Property="FontWeight" Value="{Binding IsTotal}"/>
                                                        </Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                                
                                                <Border Grid.Column="1"
                                                        Background="{Binding Class5A}"
                                                        CornerRadius="4"
                                                        Margin="5,0"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding Class5A}"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               FontSize="13">
                                                        <TextBlock.Styles>
                                                            <Style Selector="TextBlock">
                                                                <Setter Property="Foreground" Value="{Binding Class5A}"/>
                                                            </Style>
                                                        </TextBlock.Styles>
                                                    </TextBlock>
                                                </Border>
                                                
                                                <Border Grid.Column="2"
                                                        Background="{Binding Class5B}"
                                                        CornerRadius="4"
                                                        Margin="5,0"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding Class5B}"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               FontSize="13">
                                                        <TextBlock.Styles>
                                                            <Style Selector="TextBlock">
                                                                <Setter Property="Foreground" Value="{Binding Class5B}"/>
                                                            </Style>
                                                        </TextBlock.Styles>
                                                    </TextBlock>
                                                </Border>
                                                
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding NormMinMax}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="#7F8C8D"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</UserControl>
