<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SchoolAssistancePlatform.UI.Views.Pages.ReportsPage"
             mc:Ignorable="d"
             x:Class="SchoolAssistancePlatform.UI.Views.Pages.ReportsPage.ReportsPageView"
             x:DataType="vm:ReportsPageViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="20">

        <!-- Кнопки-вкладки + Обновить -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0 0 0 16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC"
                        CornerRadius="6" Padding="16,8"
                        Command="{Binding SwitchTabCommand}" CommandParameter="grades">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📊" FontSize="14"/>
                        <TextBlock Text="Успеваемость" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC"
                        CornerRadius="6" Padding="16,8"
                        Command="{Binding SwitchTabCommand}" CommandParameter="finance">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💰" FontSize="14"/>
                        <TextBlock Text="Финансы" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Column="1"
                    Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC"
                    CornerRadius="6" Padding="14,8"
                    Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="↻" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Обновить" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Сводные карточки -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="0 0 0 20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="16"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportCardViewModel">
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10"
                            Background="White" Padding="20,14" MinWidth="180">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13" Foreground="#888"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Value}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding Color}"/>
                            <TextBlock Text="{Binding Sub}"
                                       FontSize="11" Foreground="#AAA"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Контент вкладок -->
        <Grid Grid.Row="2">

            <!-- Таблица успеваемости -->
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="White"
                    IsVisible="{Binding IsGradesTab}">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="14,10"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Styles>
                            <TextBlock Grid.Column="0" Text="Класс"/>
                            <TextBlock Grid.Column="1" Text="Учеников"     HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Средний балл" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Отл. (5)"     HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Хор. (4)"     HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Уд. (3)"      HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Неуд. (2)"    HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <ListBox ItemsSource="{Binding GradeRows}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GradeReportRowViewModel">
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Klass}"
                                                       Padding="14,10"
                                                       FontWeight="SemiBold" FontSize="13"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Students}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#555"/>

                                            <Border Grid.Column="2"
                                                    Background="{Binding AvgGradeColor}"
                                                    CornerRadius="16"
                                                    Padding="16,4"
                                                    MinWidth="60"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AvgGradeText}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="{Binding Excellent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#27AE60" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Good}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#3498DB" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Satisfactory}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#E67E22" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Poor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#E74C3C" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Таблица финансов -->
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="White"
                    IsVisible="{Binding IsFinanceTab}">
                <Grid RowDefinitions="Auto, Auto, *">

                    <!-- Выбор года -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="16,12">
                        <TextBlock Text="Год:" VerticalAlignment="Center" FontSize="13" Foreground="#666"/>
                        <ComboBox ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Width="110"/>
                    </StackPanel>

                    <!-- Заголовок таблицы -->
                    <Border Grid.Row="1" Background="#2C3E50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="14,10"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Styles>
                            <TextBlock Grid.Column="0" Text="Месяц"/>
                            <TextBlock Grid.Column="1" Text="Доходы"  HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Расходы" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Баланс"  HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2">
                        <ListBox ItemsSource="{Binding FinanceRows}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FinanceReportRowViewModel">
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Month}"
                                                       Padding="14,10"
                                                       FontWeight="SemiBold" FontSize="13"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding IncomeText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#27AE60" FontWeight="SemiBold"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ExpenseText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" Foreground="#E74C3C" FontWeight="SemiBold"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding BalanceText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{Binding BalanceColor}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
