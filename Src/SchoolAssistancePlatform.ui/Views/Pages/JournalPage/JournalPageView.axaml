<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SchoolAssistancePlatform.UI.Views.Pages.JournalPage"
             mc:Ignorable="d"
             x:Class="SchoolAssistancePlatform.UI.Views.Pages.JournalPage.JournalPageView"
             x:DataType="vm:JournalPageViewModel">

    <Grid Margin="20" RowDefinitions="Auto, *">

        <!-- Панель фильтров -->
        <Grid ColumnDefinitions="*, Auto" Margin="0 0 0 20">

            <Border BorderThickness="1" BorderBrush="#CCCCCC" Margin="0 0 20 0" CornerRadius="3">
                <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="20 0">

                        <ComboBox PlaceholderText="Класс"
                                  Width="160"
                                  Margin="0 0 16 0"
                                  ItemsSource="{Binding Klasses}"
                                  SelectedItem="{Binding SelectedKlass}"
                                  DisplayMemberBinding="{Binding NomerKlassa}"/>

                        <ComboBox PlaceholderText="Предмет"
                                  Width="200"
                                  Margin="0 0 16 0"
                                  ItemsSource="{Binding Subjects}"
                                  SelectedItem="{Binding SelectedSubject}"
                                  DisplayMemberBinding="{Binding Nazvanie}"/>

                        <ComboBox PlaceholderText="Период"
                                  Width="180"
                                  ItemsSource="{Binding Periods}"
                                  SelectedItem="{Binding SelectedPeriod}"
                                  DisplayMemberBinding="{Binding Label}"/>

                    </StackPanel>

                    <ToggleButton Background="Transparent"
                                  IsChecked="{Binding ApplyFilter}"
                                  Grid.Column="1">
                        <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/filter.png"
                               Width="32" Height="32" Margin="10"/>
                    </ToggleButton>
                </Grid>
            </Border>

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Grid.Column="1"
                    Command="{Binding SaveJournalCommand}">
                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Stretch" Margin="10 0">
                    <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/disk.png"
                           Width="32" Height="32" HorizontalAlignment="Center" Margin="10"/>
                    <TextBlock Text="Сохранить" FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <!-- Журнал -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid RowDefinitions="Auto, *">

                <!-- Заголовок с датами -->
                <Border Grid.Row="0"
                        Background="#F8F9FA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="200, *, 90">

                        <TextBlock Grid.Column="0"
                                   Text="👤 Ученик"
                                   FontWeight="Bold"
                                   Padding="12,10"
                                   Foreground="#555"
                                   VerticalAlignment="Center"/>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Dates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DateHeaderViewModel">
                                    <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Width="70">
                                        <TextBlock Text="{Binding Day}"
                                                   FontWeight="Bold"
                                                   Padding="6,10"
                                                   Foreground="#555"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Column="2"
                                   Text="Средний"
                                   FontWeight="Bold"
                                   Padding="8,10"
                                   Foreground="#555"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Строки учеников -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Students}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentRowViewModel">
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="200, *, 90">

                                        <!-- Имя ученика -->
                                        <Border Grid.Column="0" Padding="12,6" Background="#FAFAFA"
                                                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="👨‍🎓" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StudentName}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ячейки оценок -->
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Grades}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GradeCellViewModel">
                                                    <Border BorderBrush="#E0E0E0"
                                                            BorderThickness="1,0,0,0"
                                                            Width="70"
                                                            Padding="6,4">
                                                        <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                                 TextAlignment="Center"
                                                                 MaxLength="1"
                                                                 BorderThickness="1"
                                                                 BorderBrush="#DDD"
                                                                 CornerRadius="4"
                                                                 Padding="4,3"
                                                                 FontWeight="Bold"
                                                                 FontSize="13"
                                                                 Foreground="{Binding ForegroundColor}"
                                                                 Background="#F8F9FA"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Средний балл -->
                                        <Border Grid.Column="2"
                                                Background="{Binding AverageColor}"
                                                CornerRadius="6"
                                                Margin="8,4"
                                                Padding="6,3">
                                            <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F1}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="White"/>
                                        </Border>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

            </Grid>
        </Border>

    </Grid>
</UserControl>
