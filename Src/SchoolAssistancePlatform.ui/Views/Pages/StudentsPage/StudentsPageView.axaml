<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

			 x:Class="SchoolAssistancePlatform.UI.StudentsPageView">

    <Grid RowDefinitions="Auto, *"
		  Margin="20">

		<Grid ColumnDefinitions="*, Auto"
			  Margin="0 0 0 20">

			<Button HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					Background="Transparent"
					BorderThickness="1"
					BorderBrush="#CCCCCC"
					Grid.Column="1"
					Command="{Binding AddStudentsCommand}">
			
				<Grid ColumnDefinitions="Auto, *"
					  HorizontalAlignment="Stretch"
					  Margin="10 0">
			
					 <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/add-user.png"
							Width="32" Height="32"
							HorizontalAlignment="Center"
							Margin="10"/>
			
					<TextBlock Text="Добавить"
							   FontWeight="Bold"
							   Grid.Column="1"
							   VerticalAlignment="Center"/>
				</Grid>
			
			</Button>
		</Grid>

    <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="0,10,0,0">
    
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                CornerRadius="8,8,0,0" 
                Padding="12,10" 
                Margin="0,0,0,2">
            <Grid ColumnDefinitions="*, *, *, *, *, *">
                <TextBlock Grid.Column="0" Text="📋 ФИО" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Grid.Column="1" Text="🏫 Класс" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Grid.Column="2" Text="🎂 Дата рождения" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Grid.Column="3" Text="👨‍👩‍👧 Родители" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Grid.Column="4" Text="⭐ Средний балл" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Grid.Column="5" Text="⚙️ Действия" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
            </Grid>
        </Border>
    
        <ItemsControl Grid.Row="1" 
                 ItemsSource="{Binding Students}"
                 BorderThickness="1"
                 BorderBrush="#E0E0E0"
                 Background="#FAFAFA">
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" 
                            BorderThickness="0,0,0,1" 
                            Background="White"
                            Padding="10">
                        <Grid ColumnDefinitions="*, *, *, *, *, *">
                            
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding FullName}" 
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#2C3E50"/>
                            
                            <Border Grid.Column="1" 
                                    Background="#E8F4FD" 
                                    CornerRadius="10" 
                                    Padding="8,3"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Class}" 
                                           Foreground="#2980B9"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                            </Border>
                            
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding BirthDate}" 
                                       HorizontalAlignment="Center"
                                       Foreground="#7F8C8D"/>
                            
                            <TextBlock Grid.Column="3" 
                                       Text="{Binding Parents}" 
                                       HorizontalAlignment="Center"
                                       Foreground="#34495E"/>
                            
                            <Border Grid.Column="4" 
                                    Background="#3498DB" 
                                    CornerRadius="12" 
                                    Padding="8,3"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AverageScore}" 
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="13"/>
                            </Border>
                            
                            <Button Grid.Column="5" 
                                    Content="✏️ Редактировать"
                                    Command="{Binding EditCommand}"
                                    HorizontalAlignment="Center"
                                    Background="#3498DB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="12,5"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    
        </Grid>
    </Grid>

</UserControl>
