<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SchoolAssistancePlatform.UI.Views.Pages.MainPage"
             mc:Ignorable="d"
             x:Class="SchoolAssistancePlatform.UI.Views.Pages.MainPage.MainPageView"
             x:DataType="vm:MainPageViewModel">

    <ScrollViewer>
    <Grid Margin="24" RowDefinitions="Auto, Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0 0 0 20">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="22" FontWeight="Bold" Foreground="#2C3E50">
                    <Run Text="{Binding Greeting}"/>
                    <Run Text="!"/>
                </TextBlock>
                <TextBlock FontSize="13" Foreground="#888" Text="Добро пожаловать в систему управления школой"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/calendar.png"
                       Width="24" Height="24"/>
                <TextBlock Text="{Binding CurrentDate}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#555" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, *, *" Margin="0 0 0 20">

            <Button Grid.Column="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Margin="0 0 8 0"
                    Command="{Binding OpenMenuByNameCommand}" CommandParameter="Ученики">
                <Grid ColumnDefinitions="Auto, *" Margin="16,14">
                    <Border Background="#EBF5FB" CornerRadius="10" Width="46" Height="46"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/students.png"
                               Width="26" Height="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding StudentsCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="#2980B9"/>
                        <TextBlock Text="Учеников" FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="1"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Margin="4 0"
                    Command="{Binding OpenMenuByNameCommand}" CommandParameter="Сотрудники">
                <Grid ColumnDefinitions="Auto, *" Margin="16,14">
                    <Border Background="#F5EEF8" CornerRadius="10" Width="46" Height="46"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/presentation.png"
                               Width="26" Height="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding EmployeesCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="#8E44AD"/>
                        <TextBlock Text="Сотрудников" FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="2"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Margin="8 0 0 0"
                    Command="{Binding OpenMenuByNameCommand}" CommandParameter="Классы">
                <Grid ColumnDefinitions="Auto, *" Margin="16,14">
                    <Border Background="#EAFAF1" CornerRadius="10" Width="46" Height="46"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/blackboard.png"
                               Width="26" Height="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding ClassesCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="#27AE60"/>
                        <TextBlock Text="Классов" FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </Grid>
            </Button>

        </Grid>

        <!-- Средний ряд: сообщения + средний балл -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0 0 0 20">

            <!-- Карточка сообщений -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Margin="0 0 8 0">
                <StackPanel Spacing="0">

                    <!-- Шапка -->
                    <Border Background="#F8F9FA" CornerRadius="10,10,0,0"
                            BorderBrush="#E8ECF0" BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/open-email.png"
                                   Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Сообщения" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>

                    <!-- Статистика -->
                    <Grid ColumnDefinitions="*, *" Margin="16,14,16,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Входящие" FontSize="12" Foreground="#999"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding InboxCount}" FontSize="24"
                                           FontWeight="Bold" Foreground="#2C3E50"/>
                                <Border Background="#3498DB" CornerRadius="10" Padding="8,2"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding UnreadCount, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding UnreadCount}" FontSize="11"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Непрочитанных" FontSize="12" Foreground="#999"/>
                            <TextBlock Text="{Binding UnreadCount}" FontSize="24"
                                       FontWeight="Bold" Foreground="#E74C3C"/>
                        </StackPanel>
                    </Grid>

                    <!-- Кнопка перехода -->
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="1" BorderBrush="#E8ECF0"
                            CornerRadius="6" Margin="12,12"
                            Command="{Binding OpenMenuByNameCommand}" CommandParameter="Сообщения">
                        <Grid ColumnDefinitions="*, Auto" Margin="4,0">
                            <TextBlock Text="Перейти к сообщениям" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3498DB" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="→" FontSize="16" Foreground="#3498DB"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Карточка среднего балла -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Margin="8 0 0 0">
                <StackPanel Spacing="0">

                    <Border Background="#F8F9FA" CornerRadius="10,10,0,0"
                            BorderBrush="#E8ECF0" BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/star.png"
                                   Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Средний балл по школе" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="6" Margin="16,20">
                        <TextBlock Text="{Binding AvgGradeText}"
                                   FontSize="52" FontWeight="Black"
                                   Foreground="{Binding AvgGradeColor}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="из 5.00" FontSize="13" Foreground="#AAA"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="1" BorderBrush="#E8ECF0"
                            CornerRadius="6" Margin="12,0,12,12"
                            Command="{Binding OpenMenuByNameCommand}" CommandParameter="Журнал">
                        <Grid ColumnDefinitions="*, Auto" Margin="4,0">
                            <TextBlock Text="Открыть журнал" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#27AE60" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="→" FontSize="16" Foreground="#27AE60"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>

        <!-- Последние приказы -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="10">
            <Grid RowDefinitions="Auto, *">

                <!-- Шапка -->
                <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="10,10,0,0"
                        BorderBrush="#E8ECF0" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/edit-document.png"
                                   Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Последние приказы" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" Foreground="#2C3E50"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Background="Transparent" BorderThickness="1" BorderBrush="#E0E0E0"
                                CornerRadius="6" Padding="12,5"
                                Command="{Binding OpenMenuByNameCommand}" CommandParameter="Приказы">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Все приказы" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#555" VerticalAlignment="Center"/>
                                <TextBlock Text="→" FontSize="13" Foreground="#555" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Строки -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentOrders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentPrikazViewModel">
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="Auto, *, Auto">

                                    <Border Grid.Column="0"
                                            Background="{Binding BadgeColor}"
                                            CornerRadius="10" Padding="10,3"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Tip}"
                                                   FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Nomer}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#444"/>
                                        <TextBlock Text="{Binding Soderzhanie}"
                                                   FontSize="11" Foreground="#888"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DateText}"
                                               FontSize="11" Foreground="#AAA"
                                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Пустое состояние -->
                <TextBlock Grid.Row="1"
                           Text="Приказов пока нет"
                           FontSize="13" Foreground="#BBBBBB"
                           HorizontalAlignment="Center"
                           Margin="0,20"
                           IsVisible="{Binding !RecentOrders.Count}"/>

            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>

</UserControl>
