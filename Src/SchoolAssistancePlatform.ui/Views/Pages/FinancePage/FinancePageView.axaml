<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SchoolAssistancePlatform.UI.Views.Pages.FinancePage"
             mc:Ignorable="d"
             x:Class="SchoolAssistancePlatform.UI.Views.Pages.FinancePage.FinancePageView"
             x:DataType="vm:FinancePageViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="20">

        <!-- Панель фильтров и кнопки -->
        <Grid ColumnDefinitions="*, Auto" Margin="0 0 0 16">

            <Border BorderThickness="1" BorderBrush="#CCCCCC" Margin="0 0 16 0" CornerRadius="3">
                <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="16 0">

                        <ComboBox PlaceholderText="Год"
                                  Width="120"
                                  Margin="0 0 16 0"
                                  ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear}"/>

                        <TextBox PlaceholderText="🔍 Поиск по ученику, назначению..."
                                 Width="300"
                                 Text="{Binding SearchText}"
                                 CornerRadius="4"
                                 Padding="8,5"/>

                    </StackPanel>

                    <ToggleButton Background="Transparent"
                                  IsChecked="{Binding ApplyFilter}"
                                  Grid.Column="1">
                        <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/filter.png"
                               Width="32" Height="32" Margin="10"/>
                    </ToggleButton>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC"
                        Command="{Binding ExportCommand}">
                    <Grid ColumnDefinitions="Auto, Auto" Margin="8 0">
                        <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/spreadsheet.png"
                               Width="28" Height="28" Margin="6"/>
                        <TextBlock Text="Экспорт" FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC"
                        Command="{Binding ReportCommand}">
                    <Grid ColumnDefinitions="Auto, Auto" Margin="8 0">
                        <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/pdf-file.png"
                               Width="28" Height="28" Margin="6"/>
                        <TextBlock Text="Отчёт" FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Карточки сводки -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryCards}" Margin="0 0 0 16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="16"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryCardViewModel">
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8"
                            Background="White" Padding="20,14" MinWidth="200">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Label}"
                                           FontSize="13" Foreground="#777"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AmountText}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{Binding Color}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Таблица транзакций -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="White">
            <Grid RowDefinitions="Auto, *">

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0" Background="#34495E" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Styles>
                        <TextBlock Grid.Column="0" Text="Дата"/>
                        <TextBlock Grid.Column="1" Text="Ученик"/>
                        <TextBlock Grid.Column="2" Text="Класс"      HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Назначение"/>
                        <TextBlock Grid.Column="4" Text="Тип"        HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Сумма"      HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Строки -->
                <ScrollViewer Grid.Row="1">
                    <ListBox ItemsSource="{Binding Transactions}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#F8F9FA"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#F0F3F4"/>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransactionViewModel">
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DateText}"
                                                   Padding="14,10"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#666"/>

                                        <StackPanel Grid.Column="1" Orientation="Vertical"
                                                    VerticalAlignment="Center" Margin="0,8">
                                            <TextBlock Text="{Binding Student}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Klass}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#555"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Naznachenie}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#555"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"/>

                                        <!-- Бейдж типа операции -->
                                        <Border Grid.Column="4"
                                                Background="{Binding BadgeColor}"
                                                CornerRadius="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="10,3">
                                            <TextBlock Text="{Binding TipOperacii}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>

                                        <!-- Сумма -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding AmountText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="{Binding AmountColor}"
                                                   Margin="0,0,14,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

            </Grid>
        </Border>

    </Grid>


</UserControl>
