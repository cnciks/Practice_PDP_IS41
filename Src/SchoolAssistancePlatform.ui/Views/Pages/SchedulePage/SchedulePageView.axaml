<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchoolAssistancePlatform.UI.SchedulePageView">

    <UserControl.Resources>
        <DataTemplate x:Key="DayTemplate">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="{Binding Subject}" FontSize="14"/>
                <TextBlock Text="{Binding Teacher}" Foreground="Gray" FontSize="12"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">

        <!-- Панель заголовка -->
        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Класс:" FontWeight="Bold"/>
            <ComboBox DockPanel.Dock="Left" Width="50" ItemsSource="{Binding Classes}" SelectedItem="{Binding CurrentClass}"/>
            <TextBlock DockPanel.Dock="Right" Text="Неделя: 15–19 апреля" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </DockPanel>

        <!-- Основная сетка расписания -->
        <Grid Grid.Row="1" Margin="0,10,0,0">

            <!-- Определение столбцов сетки -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Время -->
                <ColumnDefinition Width="*"/>   <!-- Понедельник -->
                <ColumnDefinition Width="*"/>   <!-- Вторник -->
                <ColumnDefinition Width="*"/>   <!-- Среда -->
                <ColumnDefinition Width="*"/>   <!-- Четверг -->
                <ColumnDefinition Width="*"/>   <!-- Пятница -->
            </Grid.ColumnDefinitions>

            <!-- Заголовки столбцов -->
            <Rectangle Fill="#F0F0F0" Stroke="Black" Grid.ColumnSpan="6" RadiusX="5" RadiusY="5"/>
            <TextBlock Text="Время" Grid.Column="0" Padding="10" FontWeight="Bold"/>
            <TextBlock Text="ПН" Grid.Column="1" Padding="10" FontWeight="Bold"/>
            <TextBlock Text="ВТ" Grid.Column="2" Padding="10" FontWeight="Bold"/>
            <TextBlock Text="СР" Grid.Column="3" Padding="10" FontWeight="Bold"/>
            <TextBlock Text="ЧТ" Grid.Column="4" Padding="10" FontWeight="Bold"/>
            <TextBlock Text="ПТ" Grid.Column="5" Padding="10" FontWeight="Bold"/>

            <!-- Элементы ItemsControl для каждого дня недели -->
            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource DayTemplate}"/>
            <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource DayTemplate}"/>
            <ItemsControl Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource DayTemplate}"/>
            <ItemsControl Grid.Row="1" Grid.Column="4" ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource DayTemplate}"/>
            <ItemsControl Grid.Row="1" Grid.Column="5" ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource DayTemplate}"/>

        </Grid>

    </Grid>

</UserControl>
