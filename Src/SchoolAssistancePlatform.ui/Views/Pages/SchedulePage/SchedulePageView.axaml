<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             x:Class="SchoolAssistancePlatform.UI.SchedulePageView">

    <Grid RowDefinitions="Auto, *"
          Margin="20">

		<Grid ColumnDefinitions="*, Auto"
			  Margin="0 0 0 20">

			<Border BorderThickness="1"
					BorderBrush="#CCCCCC"
					Margin="0 0 20 0"
					CornerRadius="3">
                <Grid VerticalAlignment="Center"
                      ColumnDefinitions="*, Auto">                    
				    <StackPanel VerticalAlignment="Center"
				    			Orientation="Horizontal"
				    			Margin="20 0">
				    	<ComboBox PlaceholderText="Класс"
				    			  Width="180"
				    			  Margin="0 0 20 0"/>
				    	<ComboBox PlaceholderText="Неделя"
				    			  Width="180"
				    			  Margin="0 0 20 0"/>
				    	<ComboBox PlaceholderText="Учитель"
				    			  Width="180"/>
				    </StackPanel>

                    
				    <ToggleButton x:Name="notification"
				    			  Background="Transparent"
                                  IsChecked="{Binding ApplyFilter}"
				    			  Grid.Column="1">
				    	<Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/filter.png"
				    		Width="32" Height="32"
				    		Margin="10"/>
				    </ToggleButton>

                </Grid>
			</Border>

			<Button HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					Background="Transparent"
					BorderThickness="1"
					BorderBrush="#CCCCCC"
					Grid.Column="1"
					Command="{Binding EditScheduleCommand}">
			
				<Grid ColumnDefinitions="Auto, *"
					  HorizontalAlignment="Stretch"
					  Margin="10 0">
			
					 <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/edit.png"
							Width="32" Height="32"
							HorizontalAlignment="Center"
							Margin="10"/>
			
					<TextBlock Text="Редактировать"
							   FontWeight="Bold"
							   Grid.Column="1"
							   VerticalAlignment="Center"/>
				</Grid>
			
			</Button>
		</Grid>
        <DockPanel Grid.Row="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/> 
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Background="#F5F5F5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/> 
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="⏰ Время" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"
                                       Padding="10,5"/>
                            
                            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>
                            <TextBlock Grid.Column="1" 
                                       Text="ПН" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"
                                       Padding="10,5"/>
                            <TextBlock Grid.Column="1" 
                                       FontSize="10" 
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,3"/>
                            
                            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>
                            <TextBlock Grid.Column="2" 
                                       Text="ВТ" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"
                                       Padding="10,5"/>
                            <TextBlock Grid.Column="2" 
                                       FontSize="10" 
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,3"/>
                            
                            <Border Grid.Column="3" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>
                            <TextBlock Grid.Column="3" 
                                       Text="СР" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"
                                       Padding="10,5"/>
                            <TextBlock Grid.Column="3"
                                       FontSize="10" 
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,3"/>
                            
                            <Border Grid.Column="4" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>
                            <TextBlock Grid.Column="4" 
                                       Text="ЧТ" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"
                                       Padding="10,5"/>
                            <TextBlock Grid.Column="4" 
                                       FontSize="10" 
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,3"/>
                            
                            <Border Grid.Column="5" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>
                            <TextBlock Grid.Column="5" 
                                       Text="ПТ" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"
                                       Padding="10,5"/>
                            <TextBlock Grid.Column="5" 
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,3"/>
                        </Grid>
                    </Border>
                    
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ScheduleItems}"
                             BorderThickness="0">
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" 
                                                BorderBrush="#DDDDDD" 
                                                BorderThickness="0,0,1,0"
                                                Background="#FAFAFA">
                                            <TextBlock Text="{Binding Time}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       FontSize="14"/>
                                        </Border>
                                        
                                        <Button Grid.Column="1"
                                                Command="{Binding $parent[ListBox].DataContext.SelectLessonCommand}"
                                                CommandParameter="{Binding Monday}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="5">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Monday.Subject}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Monday.Teacher}"
                                                           FontSize="10"
                                                           Foreground="#666"/>
                                                <TextBlock Text="{Binding Monday.Room}"
                                                           FontSize="9"
                                                           Foreground="#999"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>


                                        <Button Grid.Column="2"
                                                Command="{Binding $parent[ListBox].DataContext.SelectLessonCommand}"
                                                CommandParameter="{Binding Tuesday}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="5">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Tuesday.Subject}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Tuesday.Teacher}"
                                                           FontSize="10"
                                                           Foreground="#666"/>
                                                <TextBlock Text="{Binding Tuesday.Room}"
                                                           FontSize="9"
                                                           Foreground="#999"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Border Grid.Column="3" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>


                                        <Button Grid.Column="3"
                                                Command="{Binding $parent[ListBox].DataContext.SelectLessonCommand}"
                                                CommandParameter="{Binding Wednesday}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="5">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Wednesday.Subject}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Wednesday.Teacher}"
                                                           FontSize="10"
                                                           Foreground="#666"/>
                                                <TextBlock Text="{Binding Wednesday.Room}"
                                                           FontSize="9"
                                                           Foreground="#999"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Border Grid.Column="4" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>
                                        
                                        <Button Grid.Column="4"
                                                Command="{Binding $parent[ListBox].DataContext.SelectLessonCommand}"
                                                CommandParameter="{Binding Thursday}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="5">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#FCE4EC"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Thursday.Subject}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Thursday.Teacher}"
                                                           FontSize="10"
                                                           Foreground="#666"/>
                                                <TextBlock Text="{Binding Thursday.Room}"
                                                           FontSize="9"
                                                           Foreground="#999"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Border Grid.Column="5" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"/>
                                        
                                        <Button Grid.Column="5"
                                                Command="{Binding $parent[ListBox].DataContext.SelectLessonCommand}"
                                                CommandParameter="{Binding Friday}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="5">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#E8EAF6"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Friday.Subject}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Friday.Teacher}"
                                                           FontSize="10"
                                                           Foreground="#666"/>
                                                <TextBlock Text="{Binding Friday.Room}"
                                                           FontSize="9"
                                                           Foreground="#999"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="White"
                    IsVisible="{Binding IsDetailsVisible}">
                
                <StackPanel Margin="15" Spacing="15">
                    <TextBlock Text="📋 Детали урока"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    
                    <Border Background="#F5F5F5"
                            CornerRadius="6"
                            Padding="10">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                           Text="📚 Предмет:" 
                                           FontWeight="Bold"
                                           Foreground="#555"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SelectedLesson.Subject}"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                           Text="👩‍🏫 Учитель:" 
                                           FontWeight="Bold"
                                           Foreground="#555"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SelectedLesson.Teacher}"
                                           FontSize="14"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                           Text="🏫 Кабинет:" 
                                           FontWeight="Bold"
                                           Foreground="#555"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SelectedLesson.Room}"
                                           FontSize="14"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                           Text="📅 День:" 
                                           FontWeight="Bold"
                                           Foreground="#555"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SelectedLesson.Day}"
                                           FontSize="14"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                           Text="⏰ Время:" 
                                           FontWeight="Bold"
                                           Foreground="#555"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SelectedLesson.Time}"
                                           FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <Button Command="{Binding CloseDetailsCommand}"
                            Content="Закрыть"
                            HorizontalAlignment="Stretch"
                            Padding="10"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>

</UserControl>
