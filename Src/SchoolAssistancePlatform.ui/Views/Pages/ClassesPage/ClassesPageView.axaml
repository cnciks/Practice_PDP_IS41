<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchoolAssistancePlatform.UI.ClassesPageView">
    <Grid RowDefinitions="Auto, *"
          Margin="20">

        <Grid ColumnDefinitions="*, Auto"
			  Margin="0 0 0 20">

            <StackPanel Orientation="Horizontal"
			    		Grid.Column="1">                

			    <Button HorizontalAlignment="Stretch"
			    		HorizontalContentAlignment="Stretch"
			    		Background="Transparent"
			    		BorderThickness="1"
			    		BorderBrush="#CCCCCC"
			    		Command="{Binding AddClassesCommand}">
			    
			    	<Grid ColumnDefinitions="Auto, *"
			    		  HorizontalAlignment="Stretch"
			    		  Margin="10 0">
			    
			    		 <Image Source="avares://SchoolAssistancePlatform.ui/Assets/Images/blackboard.png"
			    				Width="32" Height="32"
			    				HorizontalAlignment="Center"
			    				Margin="10"/>
			    
			    		<TextBlock Text="Добавить"
			    				   FontWeight="Bold"
			    				   Grid.Column="1"
			    				   VerticalAlignment="Center"/>
			    	</Grid>
			    
			    </Button>
            </StackPanel>
		</Grid>

        <ScrollViewer Margin="15"
                      Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Classes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10"
                                Width="280"
                                CornerRadius="12">
                            <Border x:Name="ViewMode"
                                    CornerRadius="12"
                                    Padding="20,15"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1">
                                
                                <Border.Styles>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="BorderBrush" Value="#3498DB"/>
                                    </Style>
                                </Border.Styles>
                                
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Border Grid.Row="0"
                                            Background="#3498DB"
                                            CornerRadius="8"
                                            Padding="10,5"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                        <TextBlock Text="👥" FontSize="16"/>
                                        <TextBlock Text="{Binding StudentsCount}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="учеников" Foreground="Gray" FontSize="14"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="👩‍🏫" FontSize="16"/>
                                        <TextBlock Text="{Binding Teacher}" FontSize="14" Foreground="#555"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Row="3"
                                            Command="{Binding $parent[UserControl].DataContext.EditClassCommand}"
                                            CommandParameter="{Binding}"
                                            Content="✏️ Внести изменения"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,10,0,0"
                                            Padding="8"
                                            Background="#27AE60"
                                            Foreground="White"
                                            CornerRadius="6"
                                            FontSize="12"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


    </Grid>
</UserControl>
